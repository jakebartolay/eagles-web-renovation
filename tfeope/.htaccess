DirectoryIndex index.php index.html
ErrorDocument 403 errors/403.html
ErrorDocument 404 errors/404.html
ErrorDocument 500 errors/500.html

RewriteEngine On

# Reverse proxy API calls before the app fallback.
RewriteRule ^client-api/(.*)$ client-api-proxy.php?__proxy_path=$1 [L,QSA]

# Member access and forum now live in the standalone forum app.
RewriteRule ^users/?$ /tfeope-forum/login [R=302,L]
RewriteRule ^users/login/?$ /tfeope-forum/login [R=302,L]
RewriteRule ^users/signup/?$ /tfeope-forum/signup [R=302,L]
RewriteRule ^users/(profile|portal)/?$ /tfeope-forum/profile [R=302,L]
RewriteRule ^member/login/?$ /tfeope-forum/login [R=302,L]
RewriteCond %{REQUEST_URI} !^/tfeope-forum/forum/?$ [NC]
RewriteRule ^forum/?$ /tfeope-forum/forum [R=302,L]

# Serve existing files/directories directly, including dist assets.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Fallback all public routes to the PHP entry so assets resolve under the current app folder.
RewriteRule ^ index.php [L]
